PORT=3000
# Better Auth: signing secret (>= 32 chars) and the origin the browser uses.
BETTER_AUTH_SECRET=local-development-secret-change-me-32
BETTER_AUTH_URL=http://localhost:5173
# Password given to the seeded demo accounts by `pnpm --filter @prostapaper/api seed:users`.
SEED_USER_PASSWORD=local-development-password

# Application connection only; synthetic local development.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=prostapaper
PGUSER=prostapaper_app
PGPASSWORD=local-app-password-only
PGSSLMODE=disable

# Placeholder resources; provide your own configuration if adapting this artifact.
DOCUMENT_INGEST_FUNCTION=YOUR_DOCUMENT_INGEST_FUNCTION
S3_DOCUMENT_BUCKET=YOUR_DOCUMENT_BUCKET
# AWS_PROFILE=YOUR_AWS_PROFILE

# Server-only REDCap configuration. Copy the approved token into your private .env.
REDCAP_API_URL=https://redcap.example.org/api/
# REDCAP_API_TOKEN=

# Optional: absolute path to the private gateway-only cookie JSON used by the MCP.
# REDCAP_GATEWAY_COOKIE_FILE=/absolute/path/to/rakathon/.local/redcap-gateway-cookies.json
